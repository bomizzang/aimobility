    "SEG = ['route_id', 'direction', 'stop_seq']\n",
    "PEAK = {7, 8, 9, 17, 18, 19}\n",
    "\n",
    "def input_feats(df):\n",
    "    df = df.copy()\n",
    "    d = pd.to_datetime(df.date)\n",
    "    df['dow'] = d.dt.day_of_week                                   # 0=월 ... 6=일\n",
    "    df['is_weekend'] = (df.dow >= 5).astype(int)\n",
    "    df['is_peak'] = df.arrive_hour.isin(PEAK).astype(int)\n",
    "    df['interval'] = np.select([df.dow == 5, df.dow == 6], [df.interval_sat, df.interval_sun], default=df.interval_wd)\n",
    "    df['dlat'] = df.to_lat - df.from_lat\n",
    "    df['dlon'] = df.to_lon - df.from_lon\n",
    "\n",
    "    g = df.groupby(['date', 'vehicle_id'])\n",
    "    prev_seq, prev_dir = g.stop_seq.shift(), g.direction.shift()\n",
    "    new_trip = prev_seq.isna() | (df.stop_seq <= prev_seq) | (df.direction != prev_dir)\n",
    "    df['trip_no'] = new_trip.astype(int).groupby([df.date, df.vehicle_id]).cumsum()\n",
    "    df['hours_since_start'] = df.arrive_hour - g.arrive_hour.transform('min')\n",
    "    first = df.first_time // 100 * 60 + df.first_time % 100\n",
    "    df['min_since_first_bus'] = df.arrive_hour * 60 - first\n",
    "    mx = df.groupby(['route_id', 'direction']).stop_seq.transform('max')\n",
    "    df['seq_ratio'] = df.stop_seq / mx\n",
    "    df['is_first_seg'] = (df.stop_seq == 1).astype(int)\n",
    "    df['is_last_seg'] = (df.stop_seq == mx).astype(int)\n",
    "    df['buses_in_hour'] = df.groupby(['date', 'route_id', 'direction', 'arrive_hour']).vehicle_id.transform('nunique')\n",
    "    return df\n",
    "\n",
    "tr = input_feats(train)\n",
    "te = input_feats(test)\n",
    "tr[['vehicle_id', 'date', 'arrive_hour', 'stop_seq', 'trip_no', 'hours_since_start', 'seq_ratio', 'buses_in_hour', 'tt_sec']].head(8)"

   "source": [
    "LGB_PARAMS = dict(objective='regression_l1', learning_rate=0.1, num_leaves=127, min_child_samples=50,\n",
    "                  subsample=0.8, subsample_freq=1, colsample_bytree=0.8, n_estimators=300, random_state=0, verbose=-1)\n",
    "\n",
    "def lgb_fn(feats, target='raw', **over):\n",
    "    params = {**LGB_PARAMS, **over}\n",
    "    def fn(fit, df):\n",
    "        Xf, Xd = make_X(fit, fit, feats, True), make_X(fit, df, feats, False)\n",
    "        y = np.log1p(fit.tt_sec) if target == 'log' else fit.tt_sec\n",
    "        p = lgb.LGBMRegressor(**params).fit(Xf, y).predict(Xd)\n",
    "        return np.expm1(p) if target == 'log' else p\n",
    "    return fn\n",
    "\n",
    "cv('LGB 실습 피처', lgb_fn(BASE), '실습 코드 그대로')\n",
    "cv('LGB +운행진행도', lgb_fn(BASE + TRIP), '하루 중 운행 시점, 노선 내 위치가 영향')\n",
    "cv('LGB +운행진행도+구간통계', lgb_fn(BASE + TRIP + SEGF), '구간마다 고유한 소요시간')\n",
    "cv('LGB +운행진행도+차량통계', lgb_fn(BASE + TRIP + VEHF), '차량·기사마다 빠르기가 다름')\n",
    "cv('LGB +운행진행도 (log 목표)', lgb_fn(BASE + TRIP, 'log'), '긴 꼬리 분포를 줄이면 학습이 안정적')\n",

    "DATES = sorted(tr.date.unique())\n",
    "WEEKEND_DATES = [d for d in DATES if pd.Timestamp(d).day_of_week >= 5]\n",
    "LOG, OOF = [], {}\n",
    "\n",
    "def mae(y, p):  return float(np.abs(np.asarray(y) - np.asarray(p)).mean())\n",
    "def rmse(y, p): return float(np.sqrt(((np.asarray(y) - np.asarray(p)) ** 2).mean()))\n",
    "\n",
    "def cv(name, fn, hypothesis=''):\n",
    "    \"\"\"fn(fit, df) -> df 예측값. 날짜별로 돌려서 기록함.\"\"\"\n",
    "    t = time.time()\n",
    "    oof = pd.Series(np.nan, index=tr.index)\n",
    "    for d in DATES:\n",
    "        fit, val = tr[tr.date != d], tr[tr.date == d]\n",
    "        oof[val.index] = fn(fit, val)\n",
    "    OOF[name] = oof\n",
    "    fold = {d: mae(tr.tt_sec[tr.date == d], oof[tr.date == d]) for d in DATES}\n",
    "    wd = [fold[d] for d in DATES if d not in WEEKEND_DATES]\n",
    "    we = [fold[d] for d in WEEKEND_DATES]\n",
    "    peak = tr.is_peak == 1\n",
    "    row = dict(실험=name, 가설=hypothesis, MAE=mae(tr.tt_sec, oof), RMSE=rmse(tr.tt_sec, oof),\n",
    "               평일겹=np.mean(wd), 주말겹=np.mean(we) if we else np.nan,\n",
    "               첨두=mae(tr.tt_sec[peak], oof[peak]), **{f'겹_{d[5:]}': v for d, v in fold.items()}, 초=round(time.time() - t))\n",
    "    LOG[:] = [r for r in LOG if r['실험'] != name] + [row]\n",
    "    print(f\"{name:28s} MAE {row['MAE']:.2f} | 평일겹 {row['평일겹']:.2f} | 주말겹 {row['주말겹']:.2f} | 첨두 {row['첨두']:.2f} | {row['초']}초\")\n",
    "    return oof\n",
    "\n",
    "def show_log():\n",
    "    df = pd.DataFrame(LOG)\n",
    "    os.makedirs('../experiments', exist_ok=True)\n",
    "    df.to_csv(f'../experiments/{PHASE}_log.csv', index=False, encoding='utf-8-sig')\n",
    "    return df.round(2)"
   ]

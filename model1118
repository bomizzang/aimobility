    "def stats_from(src):\n",
    "    ratio = src.tt_sec / src.groupby(SEG).tt_sec.transform('median')\n",
    "    return dict(\n",
    "        seg=src.groupby(SEG).tt_sec.agg(seg_med='median', seg_mean='mean', seg_std='std',\n",
    "                                        seg_q25=lambda x: x.quantile(.25), seg_q75=lambda x: x.quantile(.75)),\n",
    "        segh=src.groupby(SEG + ['arrive_hour']).tt_sec.median().rename('seg_hour_med'),\n",
    "        segw=src.groupby(SEG + ['is_weekend']).tt_sec.median().rename('seg_wk_med'),\n",
    "        veh=ratio.groupby(src.vehicle_id).median().rename('veh_slowness'),\n",
    "    )\n",
    "\n",
    "def apply_stats(df, st, groups):\n",
    "    out = df\n",
    "    if 'seg' in groups:\n",
    "        out = out.join(st['seg'], on=SEG).join(st['segh'], on=SEG + ['arrive_hour']).join(st['segw'], on=SEG + ['is_weekend'])\n",
    "        out['seg_hour_med'] = out.seg_hour_med.fillna(out.seg_med)\n",
    "        out['seg_wk_med'] = out.seg_wk_med.fillna(out.seg_med)\n",
    "        out['seg_speed'] = out.dist_m / out.seg_med.clip(lower=1)\n",
    "    if 'veh' in groups:\n",
    "        out = out.join(st['veh'], on='vehicle_id')\n",
    "        out['veh_slowness'] = out.veh_slowness.fillna(1.0)\n",
    "    return out\n",
    "\n",
    "def add_stats(fit, df, groups, is_fit):\n",
    "    \"\"\"fit의 tt_sec로 통계를 계산해 df에 붙임. is_fit=True면 학습 행마다 자기 날짜를 뺀 통계를 붙임.\"\"\"\n",
    "    if not groups:\n",
    "        return df\n",
    "    if not is_fit:\n",
    "        return apply_stats(df, stats_from(fit), groups)\n",
    "    parts = [apply_stats(df[df.date == d], stats_from(fit[fit.date != d]), groups) for d in sorted(fit.date.unique())]\n",
    "    return pd.concat(parts).loc[df.index]"
   ]
  },

    "def cat_fn(feats, target='log', **over):\n",
    "    params = dict(loss_function='MAE', iterations=1000, learning_rate=0.1, depth=8, random_seed=0, verbose=0, thread_count=-1)\n",
    "    params.update(over)\n",
    "    def fn(fit, df):\n",
    "        Xf, Xd = make_X(fit, fit, feats, True), make_X(fit, df, feats, False)\n",
    "        Xf['route_id'] = Xf.route_id.astype(str); Xd['route_id'] = Xd.route_id.astype(str)\n",
    "        y = np.log1p(fit.tt_sec) if target == 'log' else fit.tt_sec\n",
    "        p = CatBoostRegressor(**params, cat_features=['route_id']).fit(Xf, y).predict(Xd)\n",
    "        return np.expm1(p) if target == 'log' else p\n",
    "    return fn\n",
    "\n",
    "def xgb_fn(feats, target='log', **over):\n",
    "    params = dict(objective='reg:absoluteerror', n_estimators=400, learning_rate=0.1, max_depth=9, min_child_weight=20,\n",
    "                  subsample=0.8, colsample_bytree=0.8, tree_method='hist', enable_categorical=True, random_state=0, n_jobs=-1)\n",
    "    params.update(over)\n",
    "    def fn(fit, df):\n",
    "        Xf, Xd = make_X(fit, fit, feats, True), make_X(fit, df, feats, False)\n",
    "        y = np.log1p(fit.tt_sec) if target == 'log' else fit.tt_sec\n",
    "        p = XGBRegressor(**params).fit(Xf, y).predict(Xd)\n",
    "        return np.expm1(p) if target == 'log' else p\n",
    "    return fn\n",
    "\n",
    "def rf_fn(feats, target='log'):\n",
    "    def fn(fit, df):\n",
    "        Xf, Xd = make_X(fit, fit, feats, True), make_X(fit, df, feats, False)\n",
    "        Xf['route_id'] = Xf.route_id.cat.codes; Xd['route_id'] = Xd.route_id.cat.codes\n",
    "        y = np.log1p(fit.tt_sec) if target == 'log' else fit.tt_sec\n",
    "        p = RandomForestRegressor(n_estimators=100, min_samples_leaf=20, max_features=0.5, max_samples=0.5,\n",
    "                                  n_jobs=-1, random_state=0).fit(Xf, y).predict(Xd)\n",
    "        return np.expm1(p) if target == 'log' else p\n",
    "    return fn\n",
    "\n",
    "MODELS = {\n",
    "    'LGB': lgb_fn(BEST_FEATS, BEST_TARGET, **BEST_LGB),\n",
    "    'XGBoost': xgb_fn(BEST_FEATS, BEST_TARGET),\n",
    "    'RandomForest': rf_fn(BEST_FEATS, BEST_TARGET),\n",
    "}\n",
    "if USE_CATBOOST:\n",
    "    MODELS['CatBoost'] = cat_fn(BEST_FEATS, BEST_TARGET)\n",
    "for name, fn in MODELS.items():\n",
    "    cv(f'모델 {name}', fn, '모델 비교')\n",
    "show_log()"

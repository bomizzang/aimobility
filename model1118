    "def ens_score(names, w=None):\n",
    "    w = np.ones(len(names)) / len(names) if w is None else np.asarray(w) / np.sum(w)\n",
    "    p = sum(wi * OOF[f'모델 {n}'] for wi, n in zip(w, names))\n",
    "    return p\n",
    "\n",
    "from itertools import combinations\n",
    "for k in range(2, len(MODELS) + 1):\n",
    "  for names in combinations(MODELS, k):          # 실행한 모델로 가능한 모든 조합\n",
    "    if 'LGB' not in names: continue\n",
    "    names = list(names)\n",
    "    p = ens_score(names)\n",
    "    cv(f'앙상블 {\"+\".join(names)}', lambda fit, df, p=p: p[df.index].values, '여러 모델 평균')\n",
    "show_log()"
   ]
